
:root {
    --primary: #2563eb;
    --primary-dark: #1d4ed8;
    --primary-soft: #eff6ff;

    --background: #f6f8fc;
    --surface: #ffffff;
    --surface-soft: #f8fafc;

    --text: #0f172a;
    --text-muted: #64748b;
    --text-light: #94a3b8;

    --border: #e2e8f0;
    --border-light: #edf2f7;

    --success: #16a34a;
    --success-soft: #ecfdf3;

    --warning: #d97706;
    --warning-soft: #fff7ed;

    --danger: #dc2626;
    --danger-soft: #fef2f2;

    --sidebar-width: 248px;
    --header-height: 72px;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.04);
    --shadow-md: 0 8px 24px rgba(15, 23, 42, 0.06);
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
    background: var(--background);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
}

a {
    color: inherit;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}


/* =========================================================
   APP SHELL
========================================================= */

.app-container {
    min-height: 100vh;
}

.sidebar {
    position: fixed;
    inset: 0 auto 0 0;
    width: var(--sidebar-width);
    height: 100vh;
    padding: 22px 14px 16px;
    background: var(--surface);
    border-right: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    z-index: 1100;
}

.main-content {
    min-height: 100vh;
    margin-left: var(--sidebar-width);
}


/* =========================================================
   BRAND
========================================================= */

.brand {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 42px;
    padding: 0 10px;
    margin-bottom: 28px;
    color: var(--text);
    font-size: 18px;
    font-weight: 750;
    letter-spacing: -0.02em;
}

.brand-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    color: #fff;
    box-shadow: 0 7px 16px rgba(37, 99, 235, 0.20);
}

.sidebar-section {
    flex: 1;
}

.sidebar-label {
    display: block;
    margin: 0 10px 9px;
    color: var(--text-light);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
}

.sidebar-link {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 0 12px;
    margin-bottom: 4px;
    border-radius: 10px;
    color: #64748b;
    text-decoration: none;
    font-size: 13.5px;
    font-weight: 550;
    transition: 0.18s ease;
}

.sidebar-link i {
    width: 20px;
    text-align: center;
    font-size: 17px;
    color: #94a3b8;
    transition: 0.18s ease;
}

.sidebar-link:hover {
    background: #f8fafc;
    color: var(--text);
}

.sidebar-link:hover i {
    color: var(--primary);
}

.sidebar-link.active {
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 650;
}

.sidebar-link.active i {
    color: var(--primary);
}

.sidebar-bottom {
    padding-top: 14px;
    border-top: 1px solid var(--border-light);
}

.logout-link:hover {
    background: var(--danger-soft);
    color: var(--danger);
}


/* =========================================================
   TOP NAVBAR
========================================================= */

.top-navbar {
    position: sticky;
    top: 0;
    z-index: 900;
    height: var(--header-height);
    padding: 0 30px;
    background: rgba(255, 255, 255, 0.94);
    border-bottom: 1px solid var(--border);
    backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.navbar-left,
.navbar-right {
    display: flex;
    align-items: center;
}

.mobile-menu-btn {
    display: none;
    width: 38px;
    height: 38px;
    margin-right: 10px;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--text);
    font-size: 20px;
}

.mobile-menu-btn:hover {
    background: #f1f5f9;
}

.page-title {
    font-size: 14px;
    font-weight: 650;
    color: var(--text);
}

.notification-btn {
    position: relative;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 10px;
    background: transparent;
    color: #64748b;
    font-size: 18px;
    transition: 0.18s ease;
}

.notification-btn:hover {
    background: #f1f5f9;
    color: var(--text);
}

.notification-dot {
    position: absolute;
    width: 7px;
    height: 7px;
    top: 8px;
    right: 8px;
    border: 2px solid #fff;
    border-radius: 50%;
    background: var(--danger);
}

.user-menu {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-left: 10px;
}

.user-avatar {
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #dbeafe;
    color: var(--primary);
    font-size: 12px;
    font-weight: 750;
}

.user-info {
    display: flex;
    flex-direction: column;
    gap: 1px;
}

.user-name {
    font-size: 12.5px;
    font-weight: 650;
    color: var(--text);
}

.user-role {
    font-size: 10.5px;
    color: var(--text-muted);
}

.user-menu > i {
    margin-left: 2px;
    color: var(--text-light);
    font-size: 11px;
}


/* =========================================================
   CONTENT
========================================================= */

.content-wrapper {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 30px 32px 42px;
}

.welcome-section,
.page-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 24px;
}

.welcome-section h1,
.page-header h1 {
    margin: 0 0 5px;
    color: var(--text);
    font-size: 25px;
    line-height: 1.2;
    font-weight: 760;
    letter-spacing: -0.035em;
}

.welcome-section p,
.page-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 13px;
}

.add-vehicle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 42px;
    padding: 0 15px;
    border: 0;
    border-radius: 9px;
    background: var(--primary);
    color: #fff;
    font-size: 12.5px;
    font-weight: 650;
    text-decoration: none;
    box-shadow: 0 5px 12px rgba(37, 99, 235, 0.16);
    transition: 0.18s ease;
}

.add-vehicle-btn:hover {
    background: var(--primary-dark);
    color: #fff;
    transform: translateY(-1px);
}


/* =========================================================
   DASHBOARD STAT CARDS
========================================================= */

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 20px;
}

.stat-card {
    min-height: 102px;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: 14px;
}

.stat-icon {
    width: 46px;
    height: 46px;
    flex: 0 0 46px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    font-size: 19px;
}

.stat-icon.blue {
    background: #dbeafe;
    color: var(--primary);
}

.stat-icon.orange {
    background: var(--warning-soft);
    color: var(--warning);
}

.stat-icon.red {
    background: var(--danger-soft);
    color: var(--danger);
}

.stat-icon.green {
    background: var(--success-soft);
    color: var(--success);
}

.stat-content span {
    display: block;
    margin-bottom: 3px;
    color: var(--text-muted);
    font-size: 11.5px;
    font-weight: 500;
}

.stat-content h2 {
    margin: 0;
    color: var(--text);
    font-size: 24px;
    line-height: 1;
    font-weight: 760;
}


/* =========================================================
   DASHBOARD CARDS
========================================================= */

.dashboard-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(300px, 0.95fr);
    gap: 18px;
    margin-bottom: 18px;
}

.dashboard-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.card-header {
    min-height: 72px;
    padding: 17px 20px;
    border-bottom: 1px solid var(--border-light);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.card-header h3 {
    margin: 0 0 3px;
    color: var(--text);
    font-size: 14px;
    line-height: 1.25;
    font-weight: 700;
}

.card-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 11px;
}

.view-all {
    color: var(--primary);
    font-size: 11px;
    font-weight: 650;
    text-decoration: none;
}

.view-all:hover {
    text-decoration: underline;
}


/* =========================================================
   UPCOMING RENEWALS
========================================================= */

.renewal-item {
    display: flex;
    align-items: center;
    gap: 13px;
    min-height: 74px;
    padding: 12px 20px;
    border-bottom: 1px solid var(--border-light);
}

.renewal-item:last-child {
    border-bottom: 0;
}

.document-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-size: 17px;
}

.document-icon.insurance {
    background: #ede9fe;
    color: #7c3aed;
}

.document-icon.license {
    background: #dbeafe;
    color: var(--primary);
}

.document-icon.emission {
    background: var(--success-soft);
    color: var(--success);
}

.renewal-info {
    flex: 1;
    min-width: 0;
}

.renewal-info h4 {
    margin: 0 0 2px;
    color: var(--text);
    font-size: 12.5px;
    font-weight: 650;
}

.renewal-info span {
    display: block;
    overflow: hidden;
    color: var(--text-muted);
    font-size: 10.5px;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.renewal-status {
    min-width: 62px;
    text-align: right;
    display: flex;
    flex-direction: column;
}

.renewal-status strong {
    font-size: 12.5px;
    font-weight: 700;
}

.renewal-status span {
    margin-top: 1px;
    color: var(--text-light);
    font-size: 9.5px;
}

.renewal-status.warning strong {
    color: var(--warning);
}

.renewal-status.normal strong {
    color: var(--success);
}


/* =========================================================
   DOCUMENT STATUS
========================================================= */

.status-content {
    min-height: 236px;
    padding: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 28px;
}

.status-circle {
    width: 128px;
    height: 128px;
    flex: 0 0 128px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background:
        radial-gradient(circle at center, #fff 52%, transparent 53%),
        conic-gradient(
            #16a34a 0deg 225deg,
            #f59e0b 225deg 315deg,
            #dc2626 315deg 360deg
        );
    text-align: center;
}

.status-circle > div {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.status-circle strong {
    font-size: 26px;
    line-height: 1;
}

.status-circle span {
    margin-top: 4px;
    color: var(--text-muted);
    font-size: 10px;
}

.status-legend {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

.legend-item {
    display: flex;
    align-items: center;
    gap: 9px;
}

.legend-dot {
    width: 8px;
    height: 8px;
    flex: 0 0 8px;
    border-radius: 50%;
}

.legend-dot.green {
    background: var(--success);
}

.legend-dot.orange {
    background: var(--warning);
}

.legend-dot.red {
    background: var(--danger);
}

.legend-item div {
    display: flex;
    align-items: baseline;
    gap: 5px;
}

.legend-item strong {
    color: var(--text);
    font-size: 12px;
}

.legend-item div span {
    color: var(--text-muted);
    font-size: 10.5px;
}


/* =========================================================
   MY VEHICLES TABLE
========================================================= */

.vehicles-card {
    margin-bottom: 10px;
}

.vehicle-row {
    display: grid;
    grid-template-columns: minmax(220px, 2fr) 1fr 1fr 1fr 32px;
    align-items: center;
    gap: 12px;
    min-height: 68px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--border-light);
    color: var(--text-muted);
    font-size: 11.5px;
}

.vehicle-row:last-child {
    border-bottom: 0;
}

.vehicle-header {
    min-height: 40px;
    background: #fafbfc;
    color: var(--text-light);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.vehicle-name {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
}

.vehicle-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 17px;
}

.vehicle-name strong {
    display: block;
    margin-bottom: 2px;
    color: var(--text);
    font-size: 12.5px;
    font-weight: 650;
}

.vehicle-name small {
    color: var(--text-muted);
    font-size: 10px;
}

.status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 650;
    white-space: nowrap;
}

.status-badge.success {
    background: var(--success-soft);
    color: var(--success);
}

.warning-badge {
    background: var(--warning-soft);
    color: var(--warning);
}

.row-action {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    color: var(--text-light);
    text-decoration: none;
    transition: 0.18s ease;
}

.row-action:hover {
    background: var(--primary-soft);
    color: var(--primary);
}


/* =========================================================
   VEHICLES PAGE
========================================================= */

.vehicle-toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
}

.search-box {
    position: relative;
    flex: 1;
    max-width: 520px;
}

.search-box i {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-light);
    font-size: 15px;
    pointer-events: none;
}

.search-box input {
    width: 100%;
    height: 42px;
    padding: 0 14px 0 40px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text);
    font-size: 12.5px;
    outline: 0;
    transition: 0.18s ease;
}

.search-box input::placeholder {
    color: #a3afbf;
}

.search-box input:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.vehicle-filter {
    width: 190px;
    height: 42px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text);
    font-size: 12px;
    outline: 0;
}

.vehicle-filter:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.vehicles-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.vehicle-card {
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: 0.18s ease;
}

.vehicle-card:hover {
    border-color: #cbd5e1;
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
}

.vehicle-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 18px;
}

.vehicle-main-info {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.vehicle-large-icon {
    width: 48px;
    height: 48px;
    flex: 0 0 48px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 21px;
}

.vehicle-main-info h3 {
    margin: 0 0 3px;
    color: var(--text);
    font-size: 15px;
    font-weight: 700;
}

.vehicle-registration {
    color: var(--text-muted);
    font-size: 11px;
    letter-spacing: 0.03em;
}

.vehicle-menu-btn {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    flex: 0 0 32px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-light);
}

.vehicle-menu-btn:hover {
    background: #f1f5f9;
    color: var(--text);
}

.vehicle-details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    padding: 14px 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
}

.vehicle-details span {
    display: block;
    margin-bottom: 3px;
    color: var(--text-light);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.vehicle-details strong {
    color: var(--text);
    font-size: 11.5px;
    font-weight: 650;
}

.vehicle-status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 0;
}

.document-count {
    color: var(--text-muted);
    font-size: 10.5px;
}

.vehicle-card-actions {
    display: flex;
    gap: 8px;
}

.btn-view-vehicle {
    flex: 1;
    min-height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    border-radius: 8px;
    background: var(--primary);
    color: #fff;
    font-size: 11.5px;
    font-weight: 650;
    text-decoration: none;
    transition: 0.18s ease;
}

.btn-view-vehicle:hover {
    background: var(--primary-dark);
    color: #fff;
}

.btn-edit-vehicle {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-muted);
    text-decoration: none;
    transition: 0.18s ease;
}

.btn-edit-vehicle:hover {
    border-color: #bfdbfe;
    background: var(--primary-soft);
    color: var(--primary);
}


/* =========================================================
   EMPTY STATE
========================================================= */

.empty-search {
    display: none;
    padding: 56px 20px;
    border: 1px dashed #cbd5e1;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.75);
    text-align: center;
}

.empty-icon {
    width: 52px;
    height: 52px;
    margin: 0 auto 14px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #f1f5f9;
    color: var(--text-light);
    font-size: 19px;
}

.empty-search h3 {
    margin: 0 0 4px;
    font-size: 15px;
}

.empty-search p {
    margin: 0;
    color: var(--text-muted);
    font-size: 12px;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 1150px) {
    .stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 900px) {
    .vehicles-grid {
        grid-template-columns: 1fr;
    }

    .vehicle-row {
        grid-template-columns: minmax(200px, 2fr) 1fr 1fr;
    }

    .vehicle-row > :nth-child(4),
    .vehicle-row > :nth-child(5) {
        display: none;
    }
}

@media (max-width: 768px) {
    :root {
        --sidebar-width: 248px;
    }

    .sidebar {
        transform: translateX(-100%);
        transition: transform 0.22s ease;
        box-shadow: 12px 0 30px rgba(15, 23, 42, 0.08);
    }

    .sidebar.show {
        transform: translateX(0);
    }

    .main-content {
        margin-left: 0;
    }

    .mobile-menu-btn {
        display: grid;
        place-items: center;
    }

    .top-navbar {
        padding: 0 18px;
    }

    .content-wrapper {
        padding: 22px 18px 35px;
    }

    .welcome-section,
    .page-header {
        align-items: flex-start;
        flex-direction: column;
    }

    .welcome-section {
        gap: 15px;
    }

    .add-vehicle-btn {
        width: 100%;
    }

    .stats-grid {
        grid-template-columns: 1fr;
    }

    .status-content {
        justify-content: flex-start;
    }

    .user-info,
    .user-menu > i {
        display: none;
    }
}

@media (max-width: 560px) {
    .vehicle-toolbar {
        flex-direction: column;
        align-items: stretch;
    }

    .search-box {
        max-width: none;
    }

    .vehicle-filter {
        width: 100%;
    }

    .renewal-item {
        padding: 12px 15px;
    }

    .status-content {
        flex-direction: column;
        min-height: auto;
        padding: 24px 18px;
    }

    .vehicle-details {
        grid-template-columns: 1fr 1fr 1fr;
    }

    .vehicle-row {
        grid-template-columns: 1fr;
    }

    .vehicle-header {
        display: none;
    }

    .vehicle-row > :nth-child(2),
    .vehicle-row > :nth-child(3),
    .vehicle-row > :nth-child(4),
    .vehicle-row > :nth-child(5) {
        display: none;
    }

    .vehicle-row {
        padding: 12px 16px;
    }
}

/* =========================================================
   FORM PAGES
========================================================= */

.secondary-action {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 13px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 600;
    text-decoration: none;
    transition: 0.18s ease;
}

.secondary-action:hover {
    background: #f8fafc;
    color: var(--text);
    border-color: #cbd5e1;
}

.form-card {
    max-width: 900px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.form-card-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 22px 24px;
    border-bottom: 1px solid var(--border-light);
}

.form-section-icon {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 18px;
}

.form-card-header h2 {
    margin: 0 0 3px;
    font-size: 15px;
    font-weight: 700;
}

.form-card-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 11.5px;
}

.form-card form {
    padding: 24px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-group label {
    margin-bottom: 7px;
    color: var(--text);
    font-size: 12px;
    font-weight: 650;
}

.form-group label span {
    color: var(--danger);
}

.form-group input,
.form-group select {
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #fff;
    color: var(--text);
    font-size: 12px;
    outline: none;
    transition: 0.18s ease;
}

.form-group input::placeholder {
    color: #a3afbf;
}

.form-group input:focus,
.form-group select:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.form-group small {
    margin-top: 6px;
    color: var(--text-light);
    font-size: 10px;
}

.form-divider {
    height: 1px;
    margin: 28px 0;
    background: var(--border-light);
}

.document-intro {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    background: #f8fbff;
}

.document-intro-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: #dbeafe;
    color: var(--primary);
    font-size: 16px;
}

.document-intro h3 {
    margin: 0 0 3px;
    font-size: 12.5px;
    font-weight: 650;
}

.document-intro p {
    margin: 0;
    color: var(--text-muted);
    font-size: 10.5px;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 9px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--border-light);
}

.btn-cancel {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: #fff;
    color: var(--text-muted);
    font-size: 11.5px;
    font-weight: 600;
    text-decoration: none;
}

.btn-cancel:hover {
    background: #f8fafc;
    color: var(--text);
}

.btn-save {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 17px;
    border: 0;
    border-radius: 8px;
    background: var(--primary);
    color: #fff;
    font-size: 11.5px;
    font-weight: 650;
    box-shadow: 0 5px 12px rgba(37, 99, 235, 0.14);
}

.btn-save:hover {
    background: var(--primary-dark);
}

@media (max-width: 700px) {
    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-card form,
    .form-card-header {
        padding: 18px;
    }

    .form-actions {
        flex-direction: column-reverse;
    }

    .btn-cancel,
    .btn-save {
        width: 100%;
    }
}

/* =========================================================
   VEHICLE DETAILS PAGE
========================================================= */

.breadcrumb {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 9px;
    color: var(--text-light);
    font-size: 10.5px;
}

.breadcrumb a {
    color: var(--text-muted);
    text-decoration: none;
}

.breadcrumb a:hover {
    color: var(--primary);
}

.breadcrumb i {
    font-size: 8px;
}

.vehicle-detail-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.vehicle-summary-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 28px;
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.vehicle-summary-main {
    display: flex;
    align-items: center;
    gap: 15px;
}

.vehicle-summary-icon {
    width: 58px;
    height: 58px;
    flex: 0 0 58px;
    display: grid;
    place-items: center;
    border-radius: 13px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 24px;
}

.vehicle-summary-main h2 {
    margin: 0 0 7px;
    font-size: 17px;
    font-weight: 700;
}

.vehicle-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
}

.vehicle-meta span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--text-muted);
    font-size: 10.5px;
}

.vehicle-meta i {
    color: var(--text-light);
    font-size: 12px;
}

.vehicle-health {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 7px;
}

.health-label {
    color: var(--text-light);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 700;
}

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 15px;
}

.section-heading h2 {
    margin: 0 0 4px;
    font-size: 16px;
    font-weight: 700;
}

.section-heading p {
    margin: 0;
    color: var(--text-muted);
    font-size: 11px;
}

.document-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
}

.document-card {
    overflow: hidden;
    padding: 19px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    transition: 0.18s ease;
}

.document-card:hover {
    border-color: #cbd5e1;
    box-shadow: var(--shadow-md);
    transform: translateY(-1px);
}

.document-card-header {
    display: flex;
    align-items: center;
    gap: 11px;
    margin-bottom: 21px;
}

.document-type-icon {
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-size: 18px;
}

.blue-icon {
    background: #dbeafe;
    color: var(--primary);
}

.orange-icon {
    background: var(--warning-soft);
    color: var(--warning);
}

.purple-icon {
    background: #ede9fe;
    color: #7c3aed;
}

.green-icon {
    background: var(--success-soft);
    color: var(--success);
}

.document-card-title {
    flex: 1;
    min-width: 0;
}

.document-card-title h3 {
    margin: 0 0 2px;
    color: var(--text);
    font-size: 12.5px;
    font-weight: 680;
}

.document-card-title span {
    color: var(--text-muted);
    font-size: 10px;
}

.document-menu-btn {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-light);
}

.document-menu-btn:hover {
    background: #f1f5f9;
    color: var(--text);
}

.document-date {
    padding: 13px 0;
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
}

.document-date span {
    display: block;
    margin-bottom: 4px;
    color: var(--text-light);
    font-size: 9.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

.document-date strong {
    color: var(--text);
    font-size: 13px;
    font-weight: 680;
}

.document-status-line {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 14px 0;
}

.remaining-text {
    color: var(--text-muted);
    font-size: 10px;
    text-align: right;
}

.warning-text {
    color: var(--warning);
}

.danger-text {
    color: var(--danger);
}

.danger-badge {
    background: var(--danger-soft);
    color: var(--danger);
}

.document-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding-top: 3px;
}

.document-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 10.5px;
    font-weight: 600;
    text-decoration: none;
}

.document-action:hover {
    color: var(--primary);
}

@media (max-width: 850px) {
    .document-grid {
        grid-template-columns: 1fr;
    }

    .vehicle-summary-card {
        align-items: flex-start;
        flex-direction: column;
    }

    .vehicle-health {
        align-items: flex-start;
    }
}

@media (max-width: 600px) {
    .vehicle-detail-actions,
    .section-heading {
        align-items: stretch;
        flex-direction: column;
    }

    .vehicle-detail-actions .secondary-action,
    .vehicle-detail-actions .add-vehicle-btn {
        justify-content: center;
        width: 100%;
    }

    .section-heading .secondary-action {
        justify-content: center;
    }

    .vehicle-meta {
        gap: 8px 12px;
    }
}

/* =========================================================
   DOCUMENTS PAGE
========================================================= */

.document-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 20px;
}

.document-stat-card {
    min-height: 92px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    display: flex;
    align-items: center;
    gap: 13px;
}

.document-stat-icon {
    width: 43px;
    height: 43px;
    flex: 0 0 43px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-size: 17px;
}

.document-stat-icon.blue {
    background: #dbeafe;
    color: var(--primary);
}

.document-stat-icon.green {
    background: var(--success-soft);
    color: var(--success);
}

.document-stat-icon.orange {
    background: var(--warning-soft);
    color: var(--warning);
}

.document-stat-icon.red {
    background: var(--danger-soft);
    color: var(--danger);
}

.document-stat-card span {
    display: block;
    margin-bottom: 3px;
    color: var(--text-muted);
    font-size: 10.5px;
}

.document-stat-card strong {
    display: block;
    color: var(--text);
    font-size: 22px;
    line-height: 1;
    font-weight: 750;
}


/* ---------------------------------------------------------
   DOCUMENT TOOLBAR
--------------------------------------------------------- */

.documents-toolbar {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
}

.document-search-box {
    position: relative;
    flex: 1;
    max-width: 520px;
}

.document-search-box i {
    position: absolute;
    left: 14px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-light);
    font-size: 14px;
    pointer-events: none;
}

.document-search-box input {
    width: 100%;
    height: 42px;
    padding: 0 13px 0 39px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text);
    font-size: 12px;
    outline: none;
    transition: 0.18s ease;
}

.document-search-box input::placeholder {
    color: #a3afbf;
}

.document-search-box input:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.document-filter {
    height: 42px;
    min-width: 175px;
    padding: 0 12px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text);
    font-size: 11.5px;
    outline: none;
}

.document-filter:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}


/* ---------------------------------------------------------
   DOCUMENT TABLE
--------------------------------------------------------- */

.documents-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.document-row {
    display: grid;
    grid-template-columns: minmax(240px, 2.1fr) minmax(150px, 1.15fr) minmax(140px, 1fr) minmax(125px, 0.9fr) 34px;
    align-items: center;
    gap: 14px;
    min-height: 72px;
    padding: 10px 20px;
    border-bottom: 1px solid var(--border-light);
}

.document-row:last-child {
    border-bottom: 0;
}

.document-row-header {
    min-height: 42px;
    background: #fafbfc;
    color: var(--text-light);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
}

.document-name-cell {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 0;
}

.document-list-icon {
    width: 39px;
    height: 39px;
    flex: 0 0 39px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    font-size: 16px;
}

.document-list-icon.blue {
    background: #dbeafe;
    color: var(--primary);
}

.document-list-icon.orange {
    background: var(--warning-soft);
    color: var(--warning);
}

.document-list-icon.purple {
    background: #ede9fe;
    color: #7c3aed;
}

.document-list-icon.green {
    background: var(--success-soft);
    color: var(--success);
}

.document-name-cell strong,
.document-vehicle-cell strong,
.document-expiry-cell strong {
    display: block;
    color: var(--text);
    font-size: 11.5px;
    font-weight: 650;
}

.document-name-cell small,
.document-vehicle-cell small,
.document-expiry-cell small {
    display: block;
    margin-top: 2px;
    color: var(--text-muted);
    font-size: 9.5px;
}

.document-expiry-cell .warning-text,
.document-expiry-cell .danger-text {
    font-weight: 550;
}

.document-view-btn {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--text-light);
}

.document-view-btn:hover {
    background: var(--primary-soft);
    color: var(--primary);
}


/* ---------------------------------------------------------
   EMPTY STATE
--------------------------------------------------------- */

.document-empty-state {
    display: none;
    padding: 55px 20px;
    text-align: center;
}

.document-empty-state .empty-icon {
    margin-bottom: 13px;
}

.document-empty-state h3 {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 700;
}

.document-empty-state p {
    margin: 0;
    color: var(--text-muted);
    font-size: 11.5px;
}


/* ---------------------------------------------------------
   RESPONSIVE
--------------------------------------------------------- */

@media (max-width: 1100px) {

    .document-stats-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .document-row {
        grid-template-columns:
            minmax(220px, 2fr)
            minmax(130px, 1fr)
            minmax(125px, 1fr)
            minmax(110px, 0.9fr)
            30px;
    }

}

@media (max-width: 850px) {

    .documents-toolbar {
        flex-wrap: wrap;
    }

    .document-search-box {
        flex: 1 1 100%;
        max-width: none;
    }

    .document-filter {
        flex: 1;
        min-width: 0;
    }

    .document-row {
        grid-template-columns:
            minmax(210px, 2fr)
            minmax(120px, 1fr)
            minmax(120px, 1fr)
            30px;
    }

    .document-row > :nth-child(4) {
        display: none;
    }

}

@media (max-width: 650px) {

    .document-stats-grid {
        grid-template-columns: 1fr;
    }

    .documents-toolbar {
        flex-direction: column;
        align-items: stretch;
    }

    .document-filter {
        width: 100%;
    }

    .document-row {
        grid-template-columns: 1fr 30px;
        gap: 8px;
        padding: 13px 16px;
    }

    .document-row-header {
        display: none;
    }

    .document-row > :nth-child(2),
    .document-row > :nth-child(3),
    .document-row > :nth-child(4) {
        display: none;
    }

}

/* =========================================================
   RENEWALS PAGE
========================================================= */

.renewal-summary-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid #fed7aa;
    border-radius: 9px;
    background: #fff7ed;
    color: #c2410c;
    font-size: 11px;
    font-weight: 650;
}

.renewal-summary-badge i {
    font-size: 14px;
}

.renewal-overview-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 26px;
}

.renewal-overview-card {
    min-height: 100px;
    padding: 17px;
    display: flex;
    align-items: center;
    gap: 13px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.renewal-overview-icon {
    width: 45px;
    height: 45px;
    flex: 0 0 45px;
    display: grid;
    place-items: center;
    border-radius: 11px;
    font-size: 18px;
}

.renewal-overview-card.urgent .renewal-overview-icon {
    background: var(--danger-soft);
    color: var(--danger);
}

.renewal-overview-card.upcoming .renewal-overview-icon {
    background: var(--warning-soft);
    color: var(--warning);
}

.renewal-overview-card.expired .renewal-overview-icon {
    background: #fee2e2;
    color: #b91c1c;
}

.renewal-overview-card span {
    display: block;
    margin-bottom: 2px;
    color: var(--text-muted);
    font-size: 10.5px;
}

.renewal-overview-card strong {
    display: inline-block;
    margin-right: 5px;
    color: var(--text);
    font-size: 22px;
    line-height: 1;
}

.renewal-overview-card small {
    color: var(--text-light);
    font-size: 9.5px;
}


/* ---------------------------------------------------------
   RENEWAL SECTION
--------------------------------------------------------- */

.renewals-section {
    margin-bottom: 20px;
}

.renewal-filter {
    width: 170px;
    height: 40px;
    padding: 0 11px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: var(--surface);
    color: var(--text);
    font-size: 11.5px;
    outline: none;
}

.renewal-filter:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.renewal-list-card {
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
}

.renewal-page-item {
    position: relative;
    display: grid;
    grid-template-columns: 62px 22px minmax(0, 1fr);
    gap: 12px;
    min-height: 115px;
    padding: 17px 20px;
    border-bottom: 1px solid var(--border-light);
}

.renewal-page-item:last-child {
    border-bottom: 0;
}

.renewal-date-column {
    padding-top: 3px;
    text-align: center;
}

.renewal-date-column strong {
    display: block;
    font-size: 21px;
    line-height: 1;
    font-weight: 750;
}

.renewal-date-column span {
    display: block;
    margin-top: 3px;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
}

.renewal-date-column.danger strong,
.renewal-date-column.danger span {
    color: var(--danger);
}

.renewal-date-column.warning strong,
.renewal-date-column.warning span {
    color: var(--warning);
}

.renewal-date-column.normal strong {
    color: var(--primary);
}

.renewal-date-column.normal span {
    color: var(--text-muted);
}

.renewal-timeline-line {
    position: relative;
    display: flex;
    justify-content: center;
}

.renewal-timeline-line::after {
    content: "";
    position: absolute;
    top: 17px;
    bottom: -17px;
    width: 1px;
    background: var(--border);
}

.renewal-page-item:last-child .renewal-timeline-line::after {
    display: none;
}

.timeline-dot {
    position: relative;
    z-index: 2;
    width: 10px;
    height: 10px;
    margin-top: 5px;
    border: 2px solid var(--surface);
    border-radius: 50%;
    box-shadow: 0 0 0 1px currentColor;
}

.timeline-dot.danger {
    color: var(--danger);
    background: var(--danger);
}

.timeline-dot.warning {
    color: var(--warning);
    background: var(--warning);
}

.timeline-dot.normal {
    color: var(--primary);
    background: var(--primary);
}

.renewal-page-content {
    display: grid;
    grid-template-columns: minmax(250px, 1.6fr) minmax(150px, 1fr) auto;
    align-items: center;
    gap: 20px;
}

.renewal-page-main {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
}

.renewal-page-icon {
    width: 42px;
    height: 42px;
    flex: 0 0 42px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-size: 17px;
}

.danger-icon {
    background: var(--danger-soft);
    color: var(--danger);
}

.warning-icon {
    background: var(--warning-soft);
    color: var(--warning);
}

.renewal-page-main h3 {
    margin: 0 0 4px;
    color: var(--text);
    font-size: 12.5px;
    font-weight: 680;
}

.renewal-page-main p {
    margin: 0;
    color: var(--text-muted);
    font-size: 10.5px;
}

.renewal-page-main p span {
    margin: 0 3px;
    color: var(--text-light);
}

.renewal-page-status {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
}

.renewal-page-status strong {
    color: var(--text-muted);
    font-size: 10.5px;
    font-weight: 550;
}

.renewal-action-btn {
    min-height: 36px;
    padding: 0 11px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text-muted);
    font-size: 10.5px;
    font-weight: 600;
}

.renewal-action-btn:hover {
    border-color: #bfdbfe;
    background: var(--primary-soft);
    color: var(--primary);
}


/* ---------------------------------------------------------
   REMINDER INFO
--------------------------------------------------------- */

.reminder-info-card {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 16px 18px;
    border: 1px solid #dbeafe;
    border-radius: var(--radius-md);
    background: #f8fbff;
}

.reminder-info-icon {
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #dbeafe;
    color: var(--primary);
    font-size: 17px;
}

.reminder-info-card > div:nth-child(2) {
    flex: 1;
}

.reminder-info-card h3 {
    margin: 0 0 3px;
    font-size: 12px;
    font-weight: 680;
}

.reminder-info-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 10.5px;
}

.reminder-status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--success);
    font-size: 10.5px;
    font-weight: 650;
}

.reminder-status i {
    font-size: 13px;
}


/* ---------------------------------------------------------
   RENEWALS EMPTY STATE
--------------------------------------------------------- */

.renewals-empty-state {
    display: none;
    padding: 55px 20px;
    border: 1px dashed #cbd5e1;
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.75);
    text-align: center;
}

.renewals-empty-state h3 {
    margin: 0 0 4px;
    font-size: 15px;
}

.renewals-empty-state p {
    margin: 0;
    color: var(--text-muted);
    font-size: 11.5px;
}


/* ---------------------------------------------------------
   RENEWALS RESPONSIVE
--------------------------------------------------------- */

@media (max-width: 900px) {

    .renewal-page-content {
        grid-template-columns: 1fr auto;
    }

    .renewal-page-status {
        grid-column: 1;
    }

    .renewal-page-actions {
        grid-column: 2;
        grid-row: 1 / span 2;
    }

}

@media (max-width: 700px) {

    .renewal-summary-badge {
        display: none;
    }

    .renewal-overview-grid {
        grid-template-columns: 1fr;
    }

    .section-heading {
        align-items: stretch;
        flex-direction: column;
    }

    .renewal-filter {
        width: 100%;
    }

    .renewal-page-item {
        grid-template-columns: 48px 18px minmax(0, 1fr);
        padding: 15px;
    }

    .renewal-page-content {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .renewal-page-status,
    .renewal-page-actions {
        grid-column: auto;
        grid-row: auto;
    }

    .renewal-page-actions {
        justify-self: start;
    }

    .reminder-info-card {
        align-items: flex-start;
        flex-wrap: wrap;
    }

    .reminder-status {
        width: 100%;
        padding-left: 53px;
    }

}

/* =========================================================
   PUBLIC LANDING PAGE
========================================================= */

.public-page {
    min-height: 100vh;
    background:
        radial-gradient(circle at 85% 15%, rgba(59, 130, 246, 0.08), transparent 28%),
        linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
}

.public-navbar {
    height: 72px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.public-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 18px;
    font-weight: 750;
    letter-spacing: -0.02em;
    text-decoration: none;
}

.public-brand-icon {
    width: 37px;
    height: 37px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: linear-gradient(135deg, #2563eb, #3b82f6);
    color: white;
    box-shadow: 0 7px 16px rgba(37, 99, 235, 0.18);
}

.public-nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
}

.nav-login,
.nav-signup {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 13px;
    border-radius: 8px;
    font-size: 11.5px;
    font-weight: 650;
    text-decoration: none;
}

.nav-login {
    color: var(--text-muted);
}

.nav-login:hover {
    background: #f1f5f9;
    color: var(--text);
}

.nav-signup {
    background: var(--primary);
    color: white;
}

.nav-signup:hover {
    background: var(--primary-dark);
    color: white;
}


/* =========================================================
   HERO
========================================================= */

.hero-section {
    max-width: 1180px;
    margin: 0 auto;
    padding: 72px 24px 92px;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    align-items: center;
    gap: 65px;
}

.hero-content {
    max-width: 550px;
}

.hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border: 1px solid #dbeafe;
    border-radius: 999px;
    background: #f8fbff;
    color: var(--primary);
    font-size: 9.5px;
    font-weight: 700;
}

.hero-content h1 {
    margin: 18px 0 16px;
    color: var(--text);
    font-size: clamp(38px, 5vw, 58px);
    line-height: 1.03;
    font-weight: 800;
    letter-spacing: -0.05em;
}

.hero-content h1 span {
    display: block;
    color: var(--primary);
}

.hero-content > p {
    max-width: 500px;
    margin: 0;
    color: var(--text-muted);
    font-size: 14px;
    line-height: 1.8;
}

.hero-actions {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-top: 25px;
}

.hero-primary-btn,
.hero-secondary-btn {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0 16px;
    border-radius: 9px;
    font-size: 11.5px;
    font-weight: 650;
    text-decoration: none;
}

.hero-primary-btn {
    background: var(--primary);
    color: white;
    box-shadow: 0 8px 18px rgba(37, 99, 235, 0.17);
}

.hero-primary-btn:hover {
    background: var(--primary-dark);
    color: white;
    transform: translateY(-1px);
}

.hero-secondary-btn {
    border: 1px solid var(--border);
    background: white;
    color: var(--text-muted);
}

.hero-secondary-btn:hover {
    color: var(--text);
    background: #f8fafc;
}

.hero-note {
    display: flex;
    align-items: center;
    gap: 7px;
    margin-top: 15px;
    color: var(--text-muted);
    font-size: 10px;
}

.hero-note i {
    color: var(--success);
}


/* =========================================================
   HERO APP PREVIEW
========================================================= */

.hero-preview {
    perspective: 1200px;
}

.preview-window {
    overflow: hidden;
    border: 1px solid #dbe3ef;
    border-radius: 16px;
    background: #f8fafc;
    box-shadow:
        0 30px 70px rgba(15, 23, 42, 0.12),
        0 8px 22px rgba(15, 23, 42, 0.06);
    transform: rotateY(-5deg) rotateX(2deg);
}

.preview-topbar {
    height: 38px;
    padding: 0 13px;
    display: flex;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid #e2e8f0;
    background: white;
}

.preview-dots {
    display: flex;
    gap: 5px;
}

.preview-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #cbd5e1;
}

.preview-title {
    color: #94a3b8;
    font-size: 8px;
}

.preview-content {
    min-height: 330px;
    display: flex;
}

.preview-sidebar {
    width: 54px;
    padding: 12px 8px;
    background: white;
    border-right: 1px solid #e2e8f0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
}

.preview-logo {
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    margin-bottom: 8px;
    border-radius: 7px;
    background: var(--primary);
    color: white;
    font-size: 11px;
}

.preview-nav {
    width: 25px;
    height: 7px;
    border-radius: 4px;
    background: #e2e8f0;
}

.preview-nav.active {
    background: #bfdbfe;
}

.preview-main {
    flex: 1;
    padding: 19px;
}

.preview-heading {
    margin-bottom: 16px;
}

.preview-line {
    border-radius: 4px;
    background: #cbd5e1;
}

.preview-line.large {
    width: 105px;
    height: 9px;
    margin-bottom: 7px;
}

.preview-line.small {
    width: 160px;
    height: 5px;
    background: #e2e8f0;
}

.preview-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin-bottom: 10px;
}

.preview-stat {
    min-height: 55px;
    padding: 9px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: white;
    display: flex;
    align-items: center;
    gap: 7px;
}

.preview-stat-icon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
}

.preview-stat-icon.blue {
    background: #dbeafe;
}

.preview-stat-icon.orange {
    background: #ffedd5;
}

.preview-stat-icon.red {
    background: #fee2e2;
}

.preview-stat span {
    display: block;
    width: 24px;
    height: 4px;
    margin-bottom: 5px;
    border-radius: 3px;
    background: #e2e8f0;
}

.preview-stat strong {
    display: block;
    width: 16px;
    height: 7px;
    border-radius: 3px;
    background: #cbd5e1;
}

.preview-card {
    overflow: hidden;
    border: 1px solid #e2e8f0;
    border-radius: 9px;
    background: white;
}

.preview-card-heading {
    width: 80px;
    height: 7px;
    margin: 13px;
    border-radius: 3px;
    background: #cbd5e1;
}

.preview-renewal {
    min-height: 56px;
    padding: 9px 13px;
    border-top: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 9px;
}

.preview-doc-icon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: #dbeafe;
}

.preview-doc-lines {
    flex: 1;
}

.preview-doc-lines span {
    display: block;
    width: 65px;
    height: 4px;
    margin-bottom: 5px;
    border-radius: 3px;
    background: #cbd5e1;
}

.preview-doc-lines span:last-child {
    width: 42px;
    margin-bottom: 0;
    background: #e2e8f0;
}

.preview-days {
    width: 34px;
    height: 7px;
    border-radius: 4px;
    background: #fef3c7;
}


/* =========================================================
   FEATURES
========================================================= */

.features-section {
    max-width: 1180px;
    margin: 0 auto;
    padding: 20px 24px 85px;
}

.section-intro {
    max-width: 580px;
    margin: 0 auto 35px;
    text-align: center;
}

.section-eyebrow {
    color: var(--primary);
    font-size: 9px;
    font-weight: 750;
    letter-spacing: 0.12em;
}

.section-intro h2 {
    margin: 10px 0 10px;
    font-size: 30px;
    line-height: 1.2;
    letter-spacing: -0.035em;
}

.section-intro p {
    margin: 0;
    color: var(--text-muted);
    font-size: 12px;
}

.feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
}

.feature-card {
    padding: 23px;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: white;
    box-shadow: var(--shadow-sm);
}

.feature-icon {
    width: 42px;
    height: 42px;
    margin-bottom: 17px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    font-size: 18px;
}

.feature-icon.blue {
    background: #dbeafe;
    color: var(--primary);
}

.feature-icon.purple {
    background: #ede9fe;
    color: #7c3aed;
}

.feature-icon.orange {
    background: var(--warning-soft);
    color: var(--warning);
}

.feature-card h3 {
    margin: 0 0 7px;
    font-size: 14px;
}

.feature-card p {
    margin: 0;
    color: var(--text-muted);
    font-size: 11px;
    line-height: 1.7;
}


/* =========================================================
   CTA + FOOTER
========================================================= */

.cta-section {
    max-width: 1180px;
    margin: 0 auto 55px;
    padding: 28px 30px;
    border-radius: 15px;
    background: #0f172a;
    color: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
}

.cta-section h2 {
    margin: 0 0 5px;
    font-size: 20px;
    letter-spacing: -0.02em;
}

.cta-section p {
    margin: 0;
    color: #94a3b8;
    font-size: 11px;
}

.cta-button {
    min-height: 41px;
    padding: 0 15px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 8px;
    background: white;
    color: #0f172a;
    font-size: 11px;
    font-weight: 650;
    text-decoration: none;
}

.cta-button:hover {
    background: #eff6ff;
    color: var(--primary);
}

.public-footer {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 24px 25px;
    display: flex;
    justify-content: space-between;
    color: var(--text-light);
    font-size: 10px;
}


/* =========================================================
   AUTH PAGES
========================================================= */

.auth-page {
    min-height: 100vh;
    padding: 30px 20px 35px;
    background:
        radial-gradient(circle at 15% 15%, rgba(59, 130, 246, 0.08), transparent 25%),
        radial-gradient(circle at 85% 85%, rgba(37, 99, 235, 0.05), transparent 25%),
        #f8fafc;
}

.auth-brand {
    max-width: 430px;
    margin: 0 auto 27px;
}

.auth-container {
    max-width: 430px;
    margin: 0 auto;
}

.auth-card {
    padding: 29px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: white;
    box-shadow: 0 18px 45px rgba(15, 23, 42, 0.07);
}

.register-card {
    max-width: 500px;
}

.auth-header {
    margin-bottom: 24px;
    text-align: center;
}

.auth-icon {
    width: 46px;
    height: 46px;
    margin: 0 auto 13px;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: var(--primary-soft);
    color: var(--primary);
    font-size: 20px;
}

.auth-header h1 {
    margin: 0 0 6px;
    color: var(--text);
    font-size: 23px;
    font-weight: 750;
    letter-spacing: -0.03em;
}

.auth-header p {
    margin: 0;
    color: var(--text-muted);
    font-size: 11.5px;
}

.auth-form-group {
    margin-bottom: 17px;
}

.auth-form-group label {
    display: block;
    margin-bottom: 7px;
    color: var(--text);
    font-size: 11.5px;
    font-weight: 650;
}

.auth-label-row {
    display: flex;
    justify-content: space-between;
    gap: 10px;
}

.auth-label-row a {
    color: var(--primary);
    font-size: 10px;
    font-weight: 600;
    text-decoration: none;
}

.auth-label-row a:hover {
    text-decoration: underline;
}

.auth-input-wrapper {
    position: relative;
}

.auth-input-wrapper > i:first-child {
    position: absolute;
    left: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-light);
    font-size: 14px;
    pointer-events: none;
}

.auth-input-wrapper input {
    width: 100%;
    min-height: 44px;
    padding: 0 40px 0 38px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: white;
    color: var(--text);
    font-size: 12px;
    outline: none;
    transition: 0.18s ease;
}

.auth-input-wrapper input::placeholder {
    color: #a3afbf;
}

.auth-input-wrapper input:focus {
    border-color: #93c5fd;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.08);
}

.password-toggle {
    position: absolute;
    right: 7px;
    top: 50%;
    width: 31px;
    height: 31px;
    transform: translateY(-50%);
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--text-light);
}

.password-toggle:hover {
    background: #f1f5f9;
    color: var(--text);
}

.auth-remember {
    margin: -2px 0 18px;
}

.auth-remember label {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--text-muted);
    font-size: 10.5px;
}

.auth-remember input {
    width: 14px;
    height: 14px;
    accent-color: var(--primary);
}

.auth-submit-btn {
    width: 100%;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    border-radius: 9px;
    background: var(--primary);
    color: white;
    font-size: 12px;
    font-weight: 650;
    box-shadow: 0 8px 16px rgba(37, 99, 235, 0.14);
}

.auth-submit-btn:hover {
    background: var(--primary-dark);
}

.auth-divider {
    position: relative;
    margin: 23px 0 16px;
    text-align: center;
}

.auth-divider::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--border-light);
}

.auth-divider span {
    position: relative;
    padding: 0 9px;
    background: white;
    color: var(--text-light);
    font-size: 9.5px;
}

.auth-create-account {
    min-height: 41px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--primary);
    font-size: 11.5px;
    font-weight: 650;
    text-decoration: none;
}

.auth-create-account:hover {
    background: var(--primary-soft);
    border-color: #bfdbfe;
}

.auth-footer-text {
    margin: 15px 0 0;
    color: var(--text-light);
    font-size: 9.5px;
    line-height: 1.6;
    text-align: center;
}

.auth-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.password-requirement {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    margin: -3px 0 18px;
    padding: 10px;
    border-radius: 8px;
    background: #f8fafc;
    color: var(--text-muted);
    font-size: 9.5px;
    line-height: 1.5;
}

.password-requirement i {
    margin-top: 1px;
    color: var(--primary);
    font-size: 11px;
}


/* =========================================================
   PUBLIC/AUTH RESPONSIVE
========================================================= */

@media (max-width: 900px) {

    .hero-section {
        grid-template-columns: 1fr;
        padding-top: 50px;
        gap: 50px;
    }

    .hero-content {
        max-width: 650px;
        margin: 0 auto;
        text-align: center;
    }

    .hero-actions,
    .hero-note {
        justify-content: center;
    }

    .hero-preview {
        max-width: 700px;
        width: 100%;
        margin: 0 auto;
    }

    .feature-grid {
        grid-template-columns: 1fr;
    }

}

@media (max-width: 650px) {

    .public-navbar {
        padding: 0 18px;
    }

    .hero-section {
        padding: 45px 18px 65px;
    }

    .hero-content h1 {
        font-size: 39px;
    }

    .hero-actions {
        flex-direction: column;
        align-items: stretch;
    }

    .hero-primary-btn,
    .hero-secondary-btn {
        width: 100%;
    }

    .features-section {
        padding-left: 18px;
        padding-right: 18px;
    }

    .cta-section {
        margin-left: 18px;
        margin-right: 18px;
        flex-direction: column;
        align-items: flex-start;
    }

    .public-footer {
        flex-direction: column;
        gap: 5px;
        padding-left: 18px;
        padding-right: 18px;
    }

    .auth-page {
        padding: 20px 15px 30px;
    }

    .auth-card {
        padding: 22px 18px;
    }

    .auth-form-row {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .auth-brand {
        margin-bottom: 20px;
    }

}

/* =========================================================
   DOCUMENT FORM
========================================================= */

.document-form-notice {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-top: 26px;
    padding: 14px;
    border: 1px solid #dbeafe;
    border-radius: 10px;
    background: #f8fbff;
}

.document-form-notice-icon {
    width: 38px;
    height: 38px;
    flex: 0 0 38px;
    display: grid;
    place-items: center;
    border-radius: 9px;
    background: #dbeafe;
    color: var(--primary);
    font-size: 16px;
}

.document-form-notice h3 {
    margin: 0 0 3px;
    font-size: 12px;
    font-weight: 680;
}

.document-form-notice p {
    margin: 0;
    color: var(--text-muted);
    font-size: 10.5px;
    line-height: 1.55;
}